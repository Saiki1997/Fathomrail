<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SimpDownloader.App.MainWindow"
        Title="Fathomrail"
        Width="1240" Height="800"
        MinWidth="840" MinHeight="560">
  <DockPanel>
    <Border DockPanel.Dock="Top" Padding="16,12" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Spacing="2">
          <TextBlock FontSize="16" FontWeight="SemiBold" Text="Fathomrail"/>
          <TextBlock FontSize="11" Opacity="0.65" Text="v1.1  ·  crawl → discover → resolve → download → verify"/>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <TextBlock x:Name="HdrStats" FontFamily="Consolas" FontSize="12" Opacity="0.7" VerticalAlignment="Center"/>
          <ToggleButton x:Name="BtnClip" Content="Clipboard"/>
          <ToggleButton x:Name="BtnTheme" Content="Light"/>
          <Button x:Name="BtnHashes" Content="SHA-256 list"/>
          <Button x:Name="BtnSettings" Content="Settings"/>
        </StackPanel>
      </Grid>
    </Border>

    <Border DockPanel.Dock="Top" Padding="16,12" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
        <TextBlock Text="Seed URLs — one per line" FontSize="11" Opacity="0.65" Margin="0,0,0,6"/>
        <TextBox x:Name="UrlBox" Grid.Row="1" AcceptsReturn="True" Height="64" Watermark="https://example.com/gallery"
                 FontFamily="Consolas" FontSize="12"/>
        <StackPanel Grid.Column="1" Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="12,0,0,0" VerticalAlignment="Bottom">
          <ComboBox x:Name="ProfileBox" Width="120" SelectedIndex="1">
            <ComboBoxItem Content="Fast"/>
            <ComboBoxItem Content="Balanced"/>
            <ComboBoxItem Content="Deep"/>
          </ComboBox>
          <Button x:Name="BtnRun" Content="Run"/>
          <Button x:Name="BtnPause" Content="Pause" IsEnabled="False"/>
          <Button x:Name="BtnStop" Content="Stop" IsEnabled="False"/>
        </StackPanel>
      </Grid>
    </Border>

    <UniformGrid DockPanel.Dock="Top" Columns="5" Margin="16,8">
      <TextBlock x:Name="StCrawl" Text="CRAWL" FontSize="11" HorizontalAlignment="Center"/>
      <TextBlock x:Name="StDiscover" Text="DISCOVER" FontSize="11" HorizontalAlignment="Center"/>
      <TextBlock x:Name="StResolve" Text="RESOLVE" FontSize="11" HorizontalAlignment="Center"/>
      <TextBlock x:Name="StDownload" Text="DOWNLOAD" FontSize="11" HorizontalAlignment="Center"/>
      <TextBlock x:Name="StFinalize" Text="FINALIZE" FontSize="11" HorizontalAlignment="Center"/>
    </UniformGrid>

    <Border DockPanel.Dock="Bottom" Height="240" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,1,0,0">
      <DockPanel>
        <TextBlock x:Name="MonTitle" DockPanel.Dock="Top" Margin="16,8" FontSize="11" Opacity="0.65" Text="DOWNLOAD MONITOR"/>
        <DataGrid x:Name="GridItems" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal">
          <DataGrid.Columns>
            <DataGridTextColumn Header="File" Binding="{Binding Filename}" Width="2*"/>
            <DataGridTextColumn Header="Extractor" Binding="{Binding Extractor}" Width="110"/>
            <DataGridTextColumn Header="Phase" Binding="{Binding Phase}" Width="90"/>
            <DataGridTextColumn Header="Done" Binding="{Binding BytesDone}" Width="90"/>
            <DataGridTextColumn Header="SHA-256" Binding="{Binding Sha256}" Width="160"/>
            <DataGridTextColumn Header="Error" Binding="{Binding Error}" Width="*"/>
          </DataGrid.Columns>
        </DataGrid>
      </DockPanel>
    </Border>

    <Grid ColumnDefinitions="*,280">
      <DockPanel Margin="16">
        <TextBlock x:Name="PreviewTitle" DockPanel.Dock="Top" FontSize="14" FontWeight="Medium" Text="Ready when you are" Margin="0,0,0,8"/>
        <ListBox x:Name="MediaList"/>
      </DockPanel>
      <Border Grid.Column="1" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1,0,0,0" Padding="12">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" FontSize="11" Opacity="0.65" Text="ACTIVITY" Margin="0,0,0,8"/>
          <ListBox x:Name="LogList" FontFamily="Consolas" FontSize="11"/>
        </DockPanel>
      </Border>
    </Grid>
  </DockPanel>
</Window>
