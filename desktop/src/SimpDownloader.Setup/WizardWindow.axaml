<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SimpDownloader.Setup.WizardWindow"
        Title="SimpDownloader Setup"
        Width="560" Height="420"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        Background="#0B0B0C" Foreground="#F3F3F4">
  <DockPanel Margin="28">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,16,0,0">
      <Button x:Name="BtnBack" Content="Back" IsEnabled="False"/>
      <Button x:Name="BtnNext" Content="Next"/>
      <Button x:Name="BtnCancel" Content="Cancel"/>
    </StackPanel>
    <Panel x:Name="Host"/>
  </DockPanel>
</Window>
